# Copy to .env and adjust. All optional (sane defaults in run.sh / compose).

# Model served by vLLM (must fit your VRAM). AWQ 4-bit examples:
#   Qwen/Qwen2.5-3B-Instruct-AWQ    ~6 GB   (8 GB cards)
#   Qwen/Qwen2.5-7B-Instruct-AWQ    ~10 GB  (12 GB cards)
#   Qwen/Qwen2.5-14B-Instruct-AWQ   ~20 GB  (24 GB cards)
MODEL=Qwen/Qwen2.5-3B-Instruct-AWQ

# Fraction of VRAM vLLM may use (0.0-1.0). Lower it if the card also drives a display.
GPU_UTIL=0.90

# Your wallet (created with btcli, see README step 1).
WALLET_NAME=miner
WALLET_HOTKEY=expert1

# RELAY=1 tunnels the axon through the public relay (for home GPUs behind
# CGNAT/NAT). Leave 0 on a public-IP machine (cloud / dedicated server).
RELAY=0
